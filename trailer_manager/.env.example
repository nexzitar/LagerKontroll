# Local secrets for the Flutter app. Copy this file to .env and fill in real values.
# .env is git-ignored; this template is committed.

# Google Maps API key. On Android, the Gradle build reads this and injects it
# into AndroidManifest.xml as ${MAPS_API_KEY}.
# (For iOS, set the same value in ios/Flutter/Secrets.xcconfig.)
MAPS_API_KEY=your_google_maps_api_key
